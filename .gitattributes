# Auto detect text files and perform LF normalization
* text=auto

# Проект работает на Linux. Windows подставляет свои переводы строк, из-за чего
# bash отказывается запускать скрипты с ошибкой "bad interpreter: /bin/bash^M".
# Здесь переводы строк Linux закреплены явно.
*.sh text eol=lf
*.service text eol=lf
*.py text eol=lf
