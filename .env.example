# Скопируйте этот файл в .env и заполните значения.
# Файл .env в git не попадает — токены остаются только на вашей машине.

# Токен от @BotFather. Обязателен, без него бот не запустится.
BOT_TOKEN=

# Ваш числовой Telegram ID — на него бот шлёт заявки на работу с тренером.
# Узнать можно у бота @userinfobot.
ADMIN_ID=

# Часовой пояс, в котором считается время напоминаний.
TZ=Europe/Moscow

# Ключи FatSecret для счётчика БЖУ. Берутся на platform.fatsecret.com.
# Пока пусты — бот работает целиком, кроме распознавания продуктов.
# Не забудьте внести свой IP в белый список в кабинете FatSecret.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
